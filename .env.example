# -------------------------------------------------------------------------
# Biniso environment variables
# Copy this file to .env.local and fill in the real values.
# -------------------------------------------------------------------------

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key. Used by the checkout server action for guest order writes.
# NEVER expose this to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary -> Dashboard -> API Keys (product image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (order notification emails)
RESEND_API_KEY=
ORDER_FROM_EMAIL=onboarding@resend.dev
ORDER_RECEIVER_EMAIL=

# A tracked product at or below this many units is flagged as low stock
# on the dashboard and in checkout alerts. Defaults to 5.
LOW_STOCK_THRESHOLD=5

# Store details printed on invoices
NEXT_PUBLIC_STORE_NAME=Biniso
NEXT_PUBLIC_STORE_ADDRESS=Dhaka, Bangladesh
NEXT_PUBLIC_STORE_PHONE=01XXXXXXXXX

# Public site URL, used for robots.txt, sitemap.xml and canonical/OG URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Privacy-friendly page analytics. All three must be set or nothing is loaded.
# PROVIDER is one of: umami | plausible | goatcounter
# ID is the website id for Umami, the domain for Plausible, or the count URL
# (https://<code>.goatcounter.com/count) for GoatCounter.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_ID=

# Server-only. Where unexpected errors are POSTed: a Slack or Discord incoming
# webhook, or any endpoint accepting {"text": "..."}. Errors are logged to the
# host console either way; without this they are only logged.
ERROR_WEBHOOK_URL=
